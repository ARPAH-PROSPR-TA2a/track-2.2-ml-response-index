"Manifest written to disk" = file.exists(manifest$manifest_path),
"Has all stratum FU1" = !is.null(fu1),
"Canonical omics train exists" = file.exists(fu1$artifacts$omics_change_train),
"Canonical omics test exists" = file.exists(fu1$artifacts$omics_change_test),
"Canonical y_train exists" = file.exists(fu1$artifacts$y_train),
"Canonical y_test exists" = file.exists(fu1$artifacts$y_test),
"Canonical foldid exists" = file.exists(fu1$artifacts$foldid),
"Canonical split exists" = file.exists(fu1$artifacts$split),
"Canonical feature metadata exists" = file.exists(fu1$artifacts$feature_metadata),
"ENET metrics exists" = file.exists(enet$metrics),
"ENET predictions exists" = file.exists(enet$predictions),
"ENET all weights exists" = file.exists(enet$weights_all),
"ENET omics weights exists" = file.exists(enet$weights_omics),
"ENET covariate weights exists" = file.exists(enet$weights_covariates),
"ENET model exists" = file.exists(enet$model)
)
