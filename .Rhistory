run_checks <- function(checks) {
all_pass <- TRUE
for (name in names(checks)) {
status <- if (checks[[name]]) "PASS" else "FAIL"
cat(status, " ", name, "\n", sep = "")
if (!checks[[name]]) all_pass <- FALSE
}
all_pass
}
check_model_result <- function(result, model_name) {
model <- result[[model_name]]
checks <- list(
!is.null(model),
!is.null(model$metrics) && nrow(model$metrics) == 1L,
"CV_AUC" %in% names(model$metrics),
"TEST_AUC" %in% names(model$metrics),
"INSAMPLE_AUC" %in% names(model$metrics),
!is.null(model$predictions) && nrow(model$predictions) > 0
)
names(checks) <- paste(model_name, c(
"exists",
"has metrics",
"has CV_AUC",
"has TEST_AUC",
"has INSAMPLE_AUC",
"has predictions"
))
checks
}
