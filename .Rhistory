"Metrics have CV_AUC" = "CV_AUC" %in% names(metrics),
"Metrics have TEST_AUC" = "TEST_AUC" %in% names(metrics),
"Metrics have INSAMPLE_AUC" = "INSAMPLE_AUC" %in% names(metrics),
"Predictions include train/test" = all(c("train", "test") %in% unique(predictions$SET)),
"ENET metadata includes covariates" = any(feature_metadata$FEATURE_TYPE == "covariate"),
"XGB metadata is omics only" = all(xgb_feature_metadata$FEATURE_TYPE == "omics")
))
ok <- run_checks(checks)
