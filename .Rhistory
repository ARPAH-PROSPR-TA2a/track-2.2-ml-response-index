)
# Assess HRS results
survival_data <- inner_join(construct_4way, outcome_data, by = "id")
#survival_data$Race <- as.factor(survival_data$Race) - not needed rn
survival_data$Female <- as.factor(survival_data$Female)
#survival_data$Ethnicity <- as.factor(survival_data$Ethnicity) - not needed rn
# Create age-residualized, scaled versions
survival_data <- survival_data |>
mutate(
# Age-residualized poa
poa_resid = scale(residuals(lm(poa ~ PAGE, data = survival_data, na.action = na.exclude))),
# Age-residualized theta
theta_resid = scale(residuals(lm(theta ~ PAGE, data = survival_data, na.action = na.exclude))),
# Age-residualized theta_ratio
theta_ratio_resid = scale(residuals(lm(theta_ratio ~ PAGE, data = survival_data, na.action = na.exclude))),
# Age-residualized theta_ratio_gn
theta_ratio_gn_resid = scale(residuals(lm(theta_ratio_gn ~ PAGE, data = survival_data, na.action = na.exclude)))
)
# Survival Analyses
run_survival_analysis <- function(data, clocks, outcome_time, outcome_status, control_covariates){
all_results <- data.frame(
Dataset = character(),
outcome = character(),
clock = character(),
hazard_ratio = numeric(),
lower_ci = numeric(),
upper_ci = numeric(),
n_subjects = numeric(),
n_events = numeric(),
stringsAsFactors = FALSE
)
for (clock in clocks){
formula <- as.formula(paste("Surv(", outcome_time, ",", outcome_status, ") ~",
paste(c(clock, control_covariates), collapse = " + ")))
model <- suppressWarnings(coxph(formula, data = data))
n_subjects <- model$n[1]  # The first element of model$n gives the number of subjects
n_events <- model$nevent  # This gives the number of events in the model
coeffs <- summary(model)[["coefficients"]]
hr <- coeffs[clock, "exp(coef)"]
conf_ints <- confint(model)
lower_ci <- exp(conf_ints[clock, "2.5 %"])
upper_ci <- exp(conf_ints[clock, "97.5 %"])
# Add to results dataframe
clock_results <- data.frame(
Dataset = "HRS",
outcome = "Death",
clock = clock,
hazard_ratio = hr,
lower_ci = lower_ci,
upper_ci = upper_ci,
n_subjects = n_subjects,
n_events = n_events,
stringsAsFactors = FALSE
)
all_results <- rbind(all_results, clock_results)
}
# Print formatted table at the end
for(i in 1:nrow(all_results)) {
cat(sprintf("%-25s HR: %.4f (95%% CI: %.4f-%.4f)\n",
all_results$clock[i],
all_results$hazard_ratio[i],
all_results$lower_ci[i],
all_results$upper_ci[i]))
}
cat("\n")
return(all_results)
}
# Outcome: Death / Population: All
