pheno <- readRDS("../Track1.1.1/Examples/ExampleData/pheno_example.rds")
omics <- readRDS("../Track1.1.1/Examples/ExampleData/proteomics_log2.rds")
omics <- omics[seq_len(min(20L, nrow(omics))), ]
cat("Running FAST_treatment_ML...\n")
results <- FAST_treatment_ML(
pheno = pheno,
omics = omics,
omics_type = "Proteomics",
additional_covariates = c("agebl", "mbmi"),
models = c("enet", "xgb"),
test_frac = 0.2,
cv_folds = 3,
seed = 20260605,
n_cores = 1
)
analysis <- results$analysis_change
all_fu <- analysis$all[[1]]
checks <- list(
"Has analysis_change" = "analysis_change" %in% names(results),
"Has all/male/female strata" = all(c("all", "male", "female") %in% names(analysis)),
"All stratum has FU models" = !is.null(analysis$all) && length(analysis$all) > 0,
"First FU has feature metadata" = !is.null(all_fu$feature_metadata) && nrow(all_fu$feature_metadata) > 0,
"ENET includes covariates" = any(all_fu$feature_metadata$FEATURE_TYPE == "covariate"),
"XGB metadata is omics only" = all(all_fu$xgb_feature_metadata$FEATURE_TYPE == "omics")
)
checks <- c(checks, check_model_result(all_fu, "enet"))
checks <- c(checks, check_model_result(all_fu, "xgb"))
ok <- run_checks(checks)
cat("\nRunning reports...\n")
reports <- FAST_treatment_ML_reports(
pheno = pheno,
omics = omics,
omics_type = "Proteomics",
additional_covariates = c("agebl", "mbmi")
)
report_checks <- list(
"Reports have pheno_summary" = !is.null(reports$pheno_summary),
"Reports have variable_summaries" = !is.null(reports$variable_summaries),
"Reports have randomization_reports" = !is.null(reports$randomization_reports),
"Reports have omics randomization report" = !is.null(reports$randomization_reports$omics_report),
"Reports have covariate randomization report" = !is.null(reports$randomization_reports$covariate_report)
)
ok <- run_checks(report_checks) && ok
if (!ok) {
stop("One or more checks failed.")
}
cat("\nAll checks passed.\n")
source("main.R")
